<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit Product - Timolo Business</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 20px;
      font-family: Arial, sans-serif;
      background: #f5f7fa;
    }

    .container {
      max-width: 600px;
      margin: 30px auto;
      background: white;
      padding: 25px;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    h2 {
      margin-top: 0;
    }

    label {
      display: block;
      margin-top: 15px;
      margin-bottom: 6px;
      font-weight: bold;
    }

    input,
    textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 16px;
    }

    textarea {
      min-height: 100px;
      resize: vertical;
    }

    button {
      width: 100%;
      margin-top: 20px;
      padding: 13px;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      cursor: pointer;
    }

    .save {
      background: #222;
      color: white;
    }

    .back {
      display: block;
      text-align: center;
      margin-top: 15px;
      text-decoration: none;
      color: #555;
    }
  </style>
</head>

<body>

  <div class="container">

    <h2>✏️ Edit Bidhaa / Huduma</h2>

    <form action="/products/edit/<%= index %>" method="POST" enctype="multipart/form-data">

      <label>Jina la Bidhaa / Huduma</label>
      <input
        type="text"
        name="name"
        value="<%= product.name %>"
        required
      >

      <label>Bei</label>
      <input
        type="text"
        name="price"
        value="<%= product.price %>"
        required
      >

      <% if (product.image) { %>
        <label>Picha ya Sasa</label>
        <img
          src="<%= product.image %>"
          alt="<%= product.name %>"
          style="width:100%; max-height:250px; object-fit:cover; border-radius:12px; margin-bottom:10px;"
        >
      <% } %>

      <label>📷 Badilisha Picha (optional)</label>
      <input
        type="file"
        name="image"
        accept="image/*"
      >

      <label>Ujumbe</label>
      <textarea name="message"><%= product.message %></textarea>

      <button class="save" type="submit">
        💾 Hifadhi Mabadiliko
      </button>

    </form>

    <a class="back" href="/products">
      ← Rudi kwenye Bidhaa
    </a>

  </div>

</body>
</html>
