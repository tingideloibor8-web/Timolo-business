<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jisajili - Timolo Business</title>
</head>
<body>

  <h1>Jisajili kwenye Timolo Business</h1>

  <form method="POST" action="/register">

    <label>Jina la Biashara</label><br>
    <input type="text" name="businessName" required><br><br>

    <label>Username</label><br>
    <input type="text" name="username" required><br><br>

    <label>Password</label><br>
    <input type="password" name="password" required><br><br>

    <label>Namba ya WhatsApp</label><br>
    <input type="text" name="whatsapp" placeholder="2557XXXXXXXX" required><br><br>

    <label>Location</label><br>
    <input type="text" name="location" placeholder="Arusha, Tanzania" required><br><br>

    <button type="submit">Jisajili</button>

  </form>

  <p>Tayari una account? <a href="/login">Ingia</a></p>

</body>
</html>
