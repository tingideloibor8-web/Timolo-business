<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Timolo Business</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;
    }

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 25px;
    }

    .card {
      width: 100%;
      max-width: 500px;
      background: white;
      padding: 35px 25px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    h1 {
      margin: 0 0 15px;
      font-size: 36px;
    }

    .subtitle {
      font-size: 18px;
      line-height: 1.6;
      color: #596579;
      margin-bottom: 30px;
    }

    .button {
      display: block;
      width: 100%;
      padding: 15px;
      margin: 12px 0;
      border-radius: 12px;
      text-decoration: none;
      font-size: 17px;
      font-weight: bold;
    }

    .primary {
      background: #111827;
      color: white;
    }

    .secondary {
      background: #eef1f6;
      color: #111827;
    }

    .features {
      text-align: left;
      margin: 30px 0;
      line-height: 2;
      color: #465166;
    }

    .footer {
      margin-top: 25px;
      font-size: 13px;
      color: #8a94a6;
    }
  </style>
</head>

<body>
  <div class="hero">
    <div class="card">

      <h1>Timolo Business</h1>

      <p class="subtitle">
        Tengeneza ukurasa wa biashara yako mtandaoni,
        weka bidhaa zako, bei, picha na WhatsApp,
        kisha uwape wateja link moja.
      </p>

      <div class="features">
        ✓ Weka jina la biashara yako<br>
        ✓ Ongeza bidhaa na bei<br>
        ✓ Weka picha za bidhaa<br>
        ✓ Weka WhatsApp ya biashara<br>
        ✓ Pata link ya kushare kwa wateja
      </div>

      <a class="button primary" href="/register">
        Anza Kutengeneza Biashara Yako
      </a>

      <a class="button secondary" href="/login">
        Nina Account
      </a>

      <div class="footer">
        Timolo Business — Biashara yako mtandaoni.
      </div>

    </div>
  </div>
</body>
</html>
