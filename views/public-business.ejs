<!DOCTYPE html><html lang="sw">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">  <title><%= business.name %></title>  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fa;
      color: #222;
    }

    .header {
      background: #111827;
      color: white;
      padding: 30px 20px;
      text-align: center;
    }

    .header h1 {
      margin: 0 0 8px;
      font-size: 30px;
    }

    .header p {
      margin: 6px 0;
      color: #d1d5db;
    }

    .container {
      max-width: 900px;
      margin: 25px auto;
      padding: 0 15px;
    }

    .location {
      background: white;
      padding: 15px;
      border-radius: 12px;
      margin-bottom: 20px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
    }

    .product {
      background: white;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

    .product img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .no-image {
      height: 120px;
      background: #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6b7280;
    }

    .product-content {
      padding: 15px;
    }

    .product h3 {
      margin: 0 0 8px;
    }

    .price {
      font-weight: bold;
      margin-bottom: 12px;
    }

    .whatsapp {
      display: block;
      background: #16a34a;
      color: white;
      text-decoration: none;
      text-align: center;
      padding: 11px;
      border-radius: 8px;
      font-weight: bold;
    }

    .footer {
      text-align: center;
      padding: 30px 15px;
      color: #6b7280;
    }
  </style></head><body>  <div class="header">
    <h1><%= business.name %></h1><% if (business.tagline) { %>
  <p><%= business.tagline %></p>
<% } %>

  </div>  <div class="container"><div class="location">
  📍 <%= business.location %>
</div>

<div class="products">

  <% business.products.forEach((product) => { %>

    <div class="product">

      <% if (product.image) { %>
        <img src="<%= product.image %>" alt="<%= product.name %>">
      <% } else { %>
        <div class="no-image">
          Hakuna picha
        </div>
      <% } %>

      <div class="product-content">

        <h3><%= product.name %></h3>

        <div class="price">
          <%= product.price %>
        </div>

        <a
          class="whatsapp"
          href="https://wa.me/<%= business.whatsapp %>?text=<%= encodeURIComponent(product.message || 'Habari, nahitaji ' + product.name) %>"
          target="_blank">
          💬 Wasiliana WhatsApp
        </a>

      </div>

    </div>

  <% }) %>

</div>

  </div>  <div class="footer">
    <p>Powered by Timolo Business</p>
  </div></body>
</html>
